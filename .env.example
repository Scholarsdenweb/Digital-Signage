# ─── Backend ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of the backend (used to build media URLs)
BACKEND_PUBLIC_URL=http://localhost:4000

# ─── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dsm:dsm@localhost:5432/dsm?schema=public

# ─── Auth ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d
# Secret used to HMAC device tokens at rest
DEVICE_TOKEN_SECRET=change-me-device-secret-min-32-chars-long

# ─── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the management + player apps
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER=local | s3
STORAGE_PROVIDER=local
# local
LOCAL_STORAGE_DIR=./storage-data
# s3 / Cloudflare R2 (S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=dsm-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# ─── Uploads ───────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200

# ─── History ───────────────────────────────────────────────────────────
HISTORY_RETENTION_DAYS=7

# ─── Frontend (Vite) ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
